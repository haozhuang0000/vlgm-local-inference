# VLGM Local Inference Service - Environment Configuration
# Copy this file to .env and modify as needed

# =============================================================================
# Server Settings
# =============================================================================
VLGM_HOST=0.0.0.0
VLGM_PORT=8000
VLGM_DEBUG=false

# =============================================================================
# Model Settings
# =============================================================================
# Device: "cuda", "cpu", or "auto" (auto-detect)
VLGM_DEVICE=auto

# Data type: "float16", "bfloat16", or "float32"
# Use float16 for GPU, float32 for CPU
VLGM_TORCH_DTYPE=float16

# =============================================================================
# Q-Align Settings
# =============================================================================
VLGM_QALIGN_ENABLED=true
VLGM_QALIGN_MODEL_ID=q-future/one-align

# =============================================================================
# TurboDiffusion Settings
# =============================================================================
VLGM_TURBODIFFUSION_ENABLED=true

# Model variant: Wan2.1-1.3B, Wan2.1-14B-480P, Wan2.1-14B-720P, Wan2.2-I2V
VLGM_TURBODIFFUSION_MODEL=Wan2.1-1.3B

# Number of inference steps (4 recommended for speed)
VLGM_TURBODIFFUSION_NUM_STEPS=4

# Directory containing model checkpoints
VLGM_TURBODIFFUSION_CHECKPOINT_DIR=./checkpoints

# =============================================================================
# Storage Settings
# =============================================================================
# Directory for generated outputs (videos, etc.)
VLGM_OUTPUT_DIR=./outputs

# Directory for HuggingFace model cache
VLGM_MODEL_CACHE_DIR=./model_cache

# =============================================================================
# HuggingFace Settings (optional)
# =============================================================================
# HF_TOKEN=your_huggingface_token_here
# HF_HOME=./model_cache
# TRANSFORMERS_CACHE=./model_cache
