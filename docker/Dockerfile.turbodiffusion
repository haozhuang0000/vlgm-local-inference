# =============================================================================
# TurboDiffusion Inference Service
# Python 3.12 | PyTorch 2.8.0 | CUDA 12.8
#
# Build args:
#   TD_BRANCH  – TurboDiffusion git branch / tag (default: main)
# =============================================================================
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# System dependencies  (build-essential required for CUDA extension compilation)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ffmpeg \
        git \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-dev \
    && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# uv + venv + ninja
# ---------------------------------------------------------------------------
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"
ENV UV_LINK_MODE=copy

WORKDIR /app

ENV VIRTUAL_ENV=/app/.venv
ENV PATH="/app/.venv/bin:$PATH"

RUN uv venv /app/.venv \
    && uv pip install ninja

# ---------------------------------------------------------------------------
# torch / torchvision (CUDA 12.8) — large download; cached layer
# ---------------------------------------------------------------------------
RUN uv pip install torch torchvision \
        --index-url https://download.pytorch.org/whl/cu128

# ---------------------------------------------------------------------------
# flash-attn — no pre-built wheels for torch 2.8; compiled from source.
# Must come after torch so the build can import it.
# ---------------------------------------------------------------------------
RUN uv pip install flash-attn --no-build-isolation

# ---------------------------------------------------------------------------
# Pure-python runtime deps — cached layer.
# Listed explicitly so the next (expensive CUDA-compile) layer is only
# invalidated when the TurboDiffusion source itself changes.
# Includes both TurboDiffusion deps and the VLGM app-layer deps.
# ---------------------------------------------------------------------------
RUN uv pip install \
        einops numpy pillow loguru "imageio[ffmpeg]" pandas PyYAML \
        omegaconf attrs fvcore ftfy regex transformers nvidia-ml-py \
        "prompt-toolkit>=3.0" "rich>=13.0" triton \
        fastapi uvicorn pydantic-settings httpx psutil

# ---------------------------------------------------------------------------
# Clone TurboDiffusion and compile its CUDA extensions (quant / norm / gemm).
# turbo_diffusion_ops is installed to site-packages via `uv pip install .`;
# the Python source stays on disk at /app/TurboDiffusion for sys.path imports.
# ---------------------------------------------------------------------------
ARG TD_BRANCH=main
RUN git clone --depth 1 --branch "${TD_BRANCH}" \
            https://github.com/thu-ml/TurboDiffusion.git /app/TurboDiffusion \
    && cd /app/TurboDiffusion \
    && git submodule update --init --recursive \
    && uv pip install . --no-build-isolation

# ---------------------------------------------------------------------------
# Copy app source — changes here do NOT trigger a recompile of CUDA extensions
# ---------------------------------------------------------------------------
COPY src/__init__.py                  ./src/__init__.py
COPY src/config.py                    ./src/config.py
COPY src/schema/                      ./src/schema/
COPY src/api/__init__.py              ./src/api/__init__.py
COPY src/api/app.py                   ./src/api/app.py
COPY src/api/routes/__init__.py       ./src/api/routes/__init__.py
COPY src/api/routes/turbodiffusion.py ./src/api/routes/turbodiffusion.py
COPY src/models/__init__.py           ./src/models/__init__.py
COPY src/models/base.py               ./src/models/base.py
COPY src/models/turbodiffusion.py     ./src/models/turbodiffusion.py

# ---------------------------------------------------------------------------
# Runtime configuration
# ---------------------------------------------------------------------------
ENV PYTHONPATH=/app
ENV TURBODIFFUSION_REPO_DIR=/app/TurboDiffusion
ENV VLGM_HOST=0.0.0.0
ENV VLGM_PORT=8000
ENV VLGM_DEVICE=cuda
ENV VLGM_QALIGN_ENABLED=false
ENV VLGM_TURBODIFFUSION_ENABLED=true

RUN mkdir -p /app/checkpoints /app/outputs

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["python", "-c", "from src.api.app import main; main()"]
